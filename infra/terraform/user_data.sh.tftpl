#!/bin/bash
# Bootstraps a fresh Amazon Linux 2023 (arm64) instance to run twr's production
# Docker Compose stack and registers it as a self-hosted GitHub Actions runner.
# Idempotent-ish: safe to re-run (e.g. after a user_data_replace_on_change
# instance replacement).
#
# Rendered by Terraform's templatefile() (see main.tf): bash brace expansions
# must be written with a doubled dollar sign to escape Terraform interpolation.
set -euxo pipefail

PROJECT_NAME="${project_name}"
AWS_REGION="${aws_region}"
GITHUB_REPO="${github_repo}"
GITHUB_RUNNER_LABELS="${github_runner_labels}"
GITHUB_PAT_PARAMETER="${github_pat_parameter}"
APP_DIR="/opt/$PROJECT_NAME"
RUNNER_DIR="/opt/actions-runner"

exec > >(tee -a "/var/log/$PROJECT_NAME-user-data.log") 2>&1
echo "=== $PROJECT_NAME user_data starting at $(date -u) ==="

# ------------------------------------------------------------------
# Docker + Compose plugin + JDK 25 + runner dependencies
# ------------------------------------------------------------------
dnf update -y
dnf install -y docker git jq libicu java-25-amazon-corretto-devel
# Dockerfile.jvm (src/main/docker/Dockerfile.jvm) only copies the already-built
# target/quarkus-app/ — it doesn't compile the app itself. `./mvnw package`
# needs to run on the host first (both for the first manual deploy and for
# every run of the GitHub Actions self-hosted runner, see deploy.yml), which
# requires a JDK matching <maven.compiler.release> in pom.xml (currently 25).
java -version 2>&1 | grep -q 'version "25' || { echo "ERROR: expected Java 25 as the default JDK" >&2; exit 1; }

systemctl enable --now docker
usermod -aG docker ec2-user

mkdir -p /usr/libexec/docker/cli-plugins
ARCH=$(uname -m) # aarch64 on t4g

case "$ARCH" in
  aarch64)
    COMPOSE_ARCH="aarch64"
    BUILDX_ARCH="arm64"
    ;;
  x86_64)
    COMPOSE_ARCH="x86_64"
    BUILDX_ARCH="amd64"
    ;;
  *)
    echo "unsupported arch: $ARCH" >&2
    exit 1
    ;;
esac

# Pin known-good minimums. `docker compose ... --build` needs buildx >= 0.17.0;
# Amazon Linux's docker package does not ship buildx, and GitHub API rate limits
# can leave an empty/null version — so we always install (or upgrade) and fall
# back to a pinned release when the API is unavailable.
COMPOSE_MIN_VERSION="2.32.0"
BUILDX_MIN_VERSION="0.19.0"
BUILDX_FALLBACK_TAG="v0.19.3"

install_compose_plugin() {
  curl -fsSL \
    "https://github.com/docker/compose/releases/latest/download/docker-compose-linux-$${COMPOSE_ARCH}" \
    -o /usr/libexec/docker/cli-plugins/docker-compose
  chmod +x /usr/libexec/docker/cli-plugins/docker-compose
}

install_buildx_plugin() {
  local tag=""
  tag=$(curl -fsSL https://api.github.com/repos/docker/buildx/releases/latest \
    | jq -r '.tag_name // empty' 2>/dev/null || true)
  if [ -z "$tag" ] || [ "$tag" = "null" ]; then
    echo "WARNING: could not resolve latest buildx from GitHub API; using $${BUILDX_FALLBACK_TAG}" >&2
    tag="$BUILDX_FALLBACK_TAG"
  fi
  curl -fsSL \
    "https://github.com/docker/buildx/releases/download/$${tag}/buildx-$${tag}.linux-$${BUILDX_ARCH}" \
    -o /usr/libexec/docker/cli-plugins/docker-buildx
  chmod +x /usr/libexec/docker/cli-plugins/docker-buildx
}

version_ge() {
  # Returns 0 if $1 >= $2 (semver-ish: major.minor.patch, ignores leading "v").
  local a b
  a=$(echo "$1" | sed 's/^v//;s/[^0-9.].*//')
  b=$(echo "$2" | sed 's/^v//;s/[^0-9.].*//')
  [ "$(printf '%s\n%s\n' "$b" "$a" | sort -V | head -n1)" = "$b" ]
}

COMPOSE_CURRENT=""
if [ -x /usr/libexec/docker/cli-plugins/docker-compose ]; then
  COMPOSE_CURRENT=$(docker compose version --short 2>/dev/null || true)
fi
if [ -z "$COMPOSE_CURRENT" ] || ! version_ge "$COMPOSE_CURRENT" "$COMPOSE_MIN_VERSION"; then
  echo "Installing docker-compose plugin (have='$${COMPOSE_CURRENT:-none}', need>=$COMPOSE_MIN_VERSION)"
  install_compose_plugin
fi

BUILDX_CURRENT=""
if [ -x /usr/libexec/docker/cli-plugins/docker-buildx ]; then
  BUILDX_CURRENT=$(docker buildx version 2>/dev/null | awk '{print $2}' | sed 's/^v//' || true)
fi
if [ -z "$BUILDX_CURRENT" ] || ! version_ge "$BUILDX_CURRENT" "$BUILDX_MIN_VERSION"; then
  echo "Installing docker-buildx plugin (have='$${BUILDX_CURRENT:-none}', need>=$BUILDX_MIN_VERSION)"
  install_buildx_plugin
fi

# Fail boot loudly if plugins are still missing/too old — otherwise the first
# `docker compose ... --build` fails with "compose build requires buildx 0.17+".
docker compose version
docker buildx version
BUILDX_CURRENT=$(docker buildx version | awk '{print $2}' | sed 's/^v//')
version_ge "$BUILDX_CURRENT" "0.17.0" \
  || { echo "ERROR: docker buildx $BUILDX_CURRENT is older than 0.17.0" >&2; exit 1; }

# Also expose the plugins under ec2-user's CLI path (some sessions only look there).
mkdir -p /home/ec2-user/.docker/cli-plugins
ln -sfn /usr/libexec/docker/cli-plugins/docker-compose /home/ec2-user/.docker/cli-plugins/docker-compose
ln -sfn /usr/libexec/docker/cli-plugins/docker-buildx /home/ec2-user/.docker/cli-plugins/docker-buildx
chown -R ec2-user:ec2-user /home/ec2-user/.docker

# ------------------------------------------------------------------
# Extra EBS data volume -> /data (Postgres/Redis/Ollama persistent data +
# Docker's data-root, so it's independent from the smaller root volume).
# ------------------------------------------------------------------
DATA_DEVICE=""
for candidate in /dev/nvme1n1 /dev/xvdf /dev/sdf; do
  if [ -b "$candidate" ]; then
    DATA_DEVICE="$candidate"
    break
  fi
done

DATA_MOUNT="/data"
mkdir -p "$DATA_MOUNT"

if [ -n "$DATA_DEVICE" ]; then
  if ! blkid "$DATA_DEVICE" >/dev/null 2>&1; then
    mkfs -t xfs "$DATA_DEVICE"
  fi

  UUID=$(blkid -s UUID -o value "$DATA_DEVICE")
  if ! grep -q "$UUID" /etc/fstab; then
    echo "UUID=$UUID $DATA_MOUNT xfs defaults,nofail 0 2" >> /etc/fstab
  fi
  mount -a
else
  echo "WARNING: no extra data device found; falling back to root volume for /data" >&2
fi

# Point Docker's data-root at the mounted data volume.
mkdir -p "$DATA_MOUNT/docker"
if [ ! -f /etc/docker/daemon.json ]; then
  systemctl stop docker
  cat > /etc/docker/daemon.json <<EOF
{
  "data-root": "$DATA_MOUNT/docker"
}
EOF
  systemctl start docker
fi

# ------------------------------------------------------------------
# App directory — holds the production .env (created manually via SSM, see
# docs/aws.md) used by both manual deploys and the GitHub Actions workflow.
# ------------------------------------------------------------------
mkdir -p "$APP_DIR"
chown ec2-user:ec2-user "$APP_DIR"

# ------------------------------------------------------------------
# Self-hosted GitHub Actions runner (runs .github/workflows/deploy.yml).
# Reads a GitHub PAT from SSM Parameter Store, exchanges it for a short-lived
# runner registration token and installs the runner as a systemd service.
# Never fails the boot: if anything is missing, it logs a warning and the
# runner can be registered later by re-running this section.
# ------------------------------------------------------------------
register_github_runner() {
  if [ -f "$RUNNER_DIR/.runner" ]; then
    echo "GitHub runner already configured in $RUNNER_DIR, skipping registration"
    return 0
  fi

  local pat=""
  # IAM permissions can take a few seconds to propagate to a brand-new instance.
  for attempt in 1 2 3 4 5 6; do
    set +x
    pat=$(aws ssm get-parameter --region "$AWS_REGION" --name "$GITHUB_PAT_PARAMETER" \
      --with-decryption --query Parameter.Value --output text 2>/dev/null || true)
    set -x
    [ -n "$pat" ] && break
    sleep 10
  done
  if [ -z "$pat" ]; then
    echo "WARNING: could not read SSM parameter $GITHUB_PAT_PARAMETER; skipping GitHub runner registration" >&2
    return 0
  fi

  local reg_token
  set +x
  reg_token=$(curl -fsSL -X POST \
    -H "Accept: application/vnd.github+json" \
    -H "Authorization: Bearer $pat" \
    -H "X-GitHub-Api-Version: 2022-11-28" \
    "https://api.github.com/repos/$GITHUB_REPO/actions/runners/registration-token" | jq -r .token)
  unset pat
  set -x
  if [ -z "$reg_token" ] || [ "$reg_token" = "null" ]; then
    echo "WARNING: failed to obtain a runner registration token for $GITHUB_REPO" >&2
    return 0
  fi

  local runner_arch
  case "$ARCH" in
    aarch64) runner_arch="arm64" ;;
    x86_64)  runner_arch="x64" ;;
  esac
  local runner_version
  runner_version=$(curl -fsSL https://api.github.com/repos/actions/runner/releases/latest | jq -r .tag_name | sed 's/^v//')

  mkdir -p "$RUNNER_DIR"
  curl -fsSL \
    "https://github.com/actions/runner/releases/download/v$runner_version/actions-runner-linux-$runner_arch-$runner_version.tar.gz" \
    | tar xz -C "$RUNNER_DIR"
  chown -R ec2-user:ec2-user "$RUNNER_DIR"

  set +x
  sudo -u ec2-user bash -c "cd '$RUNNER_DIR' && ./config.sh \
    --url 'https://github.com/$GITHUB_REPO' \
    --token '$reg_token' \
    --name '$PROJECT_NAME-$(hostname -s)' \
    --labels '$GITHUB_RUNNER_LABELS' \
    --unattended --replace"
  unset reg_token
  set -x

  (cd "$RUNNER_DIR" && ./svc.sh install ec2-user && ./svc.sh start)
}

register_github_runner || echo "WARNING: GitHub runner registration failed; see log above" >&2

echo "=== $PROJECT_NAME user_data finished at $(date -u) ==="
