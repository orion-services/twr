# Copy this file to .env on the EC2 instance and fill in real values.
# .env is gitignored — never commit real secrets.

# ------------------------------------------------------------------
# Public domain / TLS (Caddy requests a Let's Encrypt cert for DOMAIN)
# ------------------------------------------------------------------
# Any public hostname that resolves to this instance's IP works here — it
# does not need to be a domain you own/registered. If you don't have a
# custom domain, use one of the values from `terraform output` instead:
#   DOMAIN=<sslip_domain output>          e.g. 52-91-12-34.sslip.io
#   DOMAIN=<public_dns output>            e.g. ec2-52-91-12-34.compute-1.amazonaws.com
# See docs/aws.md ("Não quero um domínio próprio") for details.
DOMAIN=twr.example.com
ACME_EMAIL=you@example.com

# ------------------------------------------------------------------
# Postgres (chat persistence + pgvector embeddings)
# ------------------------------------------------------------------
POSTGRES_USER=twr
POSTGRES_PASSWORD=change-me-to-a-strong-password

# ------------------------------------------------------------------
# WhatsApp Cloud API (optional — leave empty to disable WhatsApp integration)
# ------------------------------------------------------------------
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=twr-webhook-verify
WHATSAPP_APP_SECRET=

# ------------------------------------------------------------------
# OpenAI (required in prod)
# ------------------------------------------------------------------
# Used as the chat model (gpt-6-luna) and the embedding model
# (text-embedding-3-small) instead of Ollama / the local MiniLM model — see
# application-prod.properties. Also used to transcribe WhatsApp audio via
# Whisper (optional; only needed if you enable WhatsApp audio messages above).
OPENAI_API_KEY=

# ------------------------------------------------------------------
# Orion Users — auth service (login/registration/2FA), runs as its own
# container alongside postgres/redis/twr (see docker-compose.yml, service
# "orion-users", built directly from https://github.com/orion-services/users).
# Shares this same Postgres instance/database (its own tables).
# ------------------------------------------------------------------
# Host port used to reach Orion Users directly (bypassing Caddy). Only useful
# for local/manual testing on the EC2 host itself — production browsers go
# through the Caddy route below instead.
ORION_USERS_HOST_PORT=8082

# Gmail SMTP used by Orion Users for email confirmation and password recovery.
# Enable 2-Step Verification in the Google account and create an App Password:
# https://myaccount.google.com/apppasswords
# Never use or commit the regular Google account password.
QUARKUS_MAILER_MOCK=false
# Orion Users already defaults to smtp.gmail.com:465 with TLS and to
# devoriontest@gmail.com as sender/username. Override both if using another
# Gmail account.
QUARKUS_MAILER_FROM=your-account@gmail.com
QUARKUS_MAILER_USERNAME=your-account@gmail.com
QUARKUS_MAILER_PASSWORD=replace-with-google-app-password

# Public link included in confirmation emails.
# Local development:
#   http://localhost:8082/users/validateEmail
# Production:
#   https://twr.example.com/orion-users/users/validateEmail
ORION_USERS_EMAIL_VALIDATION_URL=https://twr.example.com/orion-users/users/validateEmail

# ------------------------------------------------------------------
# Frontend (Vue) — baked into the client bundle at Docker build time
# ------------------------------------------------------------------
# VITE_API_BASE_URL="" (empty) means "same origin": the SPA is served by this
# same Quarkus app in production, so leave it empty unless the frontend is
# hosted separately from the API.
VITE_API_BASE_URL=
# Public URL of the Orion Users service used for login/registration/2FA, reachable
# from the end user's browser. In prod, this MUST go through Caddy on the same
# domain/TLS cert as the app (see Caddyfile) — a plain-HTTP port on a different
# origin would be blocked as mixed content from an HTTPS page:
#   VITE_ORION_USERS_URL=https://twr.example.com/orion-users
# (replace with the same value as DOMAIN above, plus "/orion-users").
VITE_ORION_USERS_URL=https://twr.example.com/orion-users
# Optional: enables "Sign in with Google" on the login screen. Leave empty to
# hide the button.
VITE_GOOGLE_CLIENT_ID=

# ------------------------------------------------------------------
# Orion Users JWT verification (backend)
# ------------------------------------------------------------------
# src/main/resources/publicKey.pem MUST be the public key of the RSA key pair
# used by the real Orion Users deployment to SIGN its JWTs (mp.jwt.verify.issuer
# in application.properties must also match Orion Users' issuer claim, currently
# "orion-users"). Replace the placeholder key committed in this repo before
# deploying to production — otherwise every request to /twr/users/*,
# /twr/conversations/*, /twr/memory and /twr/chatbot will fail with 401.
